# Copy to backend.env next to compose.yaml: the backend's settings. Database address, FRONTEND_URL, the secure session
# cookie and client addresses behind Caddy are set by compose.yaml. Never commit the filled-in file.

# Mail server is required (confirmation and reset links): your SMTP provider's address and credentials.
# MAIL_FROM should use your own domain, with SPF, DKIM and DMARC set up for it.
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_STARTTLS=true
MAIL_FROM=HourForge <no-reply@mail.example.com>

# Jira Cloud integration (optional, off by default). Needs your own OAuth 2.0 (3LO) app in the Atlassian Developer Console.
# Never commit real values. JIRA_TOKEN_ENCRYPTION_KEY is 32 random bytes in base64, e.g. from: openssl rand -base64 32
# The redirect URI must match the callback URL configured in the Developer Console exactly.
JIRA_INTEGRATION_ENABLED=false
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=https://<HOURFORGE_DOMAIN>/api/integrations/jira/callback
JIRA_TOKEN_ENCRYPTION_KEY=
# Key rotation: set a new JIRA_TOKEN_ENCRYPTION_KEY, raise JIRA_TOKEN_ENCRYPTION_KEY_VERSION (v2, v3...) and keep the old key as
# APP_JIRA_PREVIOUSENCRYPTIONKEYS_V1=<old key>. Stored tokens are rewritten with the new key the next time they are used.

# Sign-in with Google (optional, off while GOOGLE_CLIENT_ID is empty). Needs an OAuth client of type "Web application"
# in the Google Cloud console. Never commit real values; GOOGLE_CLIENT_SECRET is required once GOOGLE_CLIENT_ID is set.
# GOOGLE_REDIRECT_URI must match an authorized redirect URI of that client exactly; Google allows http only for localhost.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Behind Caddy it can stay empty: the callback is then https://<HOURFORGE_DOMAIN>/api/auth/oauth2/callback/google.
GOOGLE_REDIRECT_URI=

# Approximate place of sign-ins (optional). Path to a local IP location database in the .mmdb format, for example the
# free DB-IP "IP to City Lite" file (https://db-ip.com/db/lite.php, CC BY 4.0). Lookups never leave the server.
# Without a file only shortened addresses (83.24.x.x) are shown. Set GEOIP_ATTRIBUTION when using another database.
GEOIP_DATABASE=

# Two-step sign-in with an authenticator app. Secrets are encrypted with this key: 32 random bytes in base64, e.g. from
# openssl rand -base64 32. Without it people cannot turn two-step sign-in on. Keep it: losing it locks out everyone who
# uses two-step sign-in until the instance operator turns it off for them.
TWO_FACTOR_ENCRYPTION_KEY=
# Key rotation: set a new TWO_FACTOR_ENCRYPTION_KEY, raise TWO_FACTOR_ENCRYPTION_KEY_VERSION (v2, v3...) and keep the old
# key as APP_TWOFACTOR_PREVIOUSENCRYPTIONKEYS_V1=<old key>. At the next start every secret is rewritten with the new key;
# the old one can then be removed.
TWO_FACTOR_ENCRYPTION_KEY_VERSION=v1

# Bot protection on the registration form (optional): Cloudflare Turnstile keys from the Cloudflare dashboard.
# Off when either key is empty. When on, the registration page loads Cloudflare's widget script.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Instance operator panel (/operator): comma-separated e-mail addresses of the accounts that run this instance.
# They can see usage statistics, block and remove abusive accounts and teams, and show a notice to everybody.
OPERATOR_EMAILS=
