# Copy to .env next to compose.yaml. Read by Docker Compose only; the backend gets its settings from backend.env.
# Use plain KEY=value entries; long random passwords of letters and digits (e.g. openssl rand -hex 24).

# Address of the application. A public name needs DNS (A/AAAA) pointing at this server and ports 80 and 443 open;
# Caddy then gets a Let's Encrypt certificate. "localhost" uses Caddy's own local certificate, for trying it out.
HOURFORGE_DOMAIN=localhost

# Database. POSTGRES_PASSWORD is the administrator's; the backend signs in as DB_USERNAME with DB_PASSWORD and can only
# read and write rows. The "migrate" step changes the schema as MIGRATION_DB_USERNAME (must differ from DB_USERNAME).
DB_NAME=hourforge
DB_USERNAME=hourforge
DB_PASSWORD=change_me
MIGRATION_DB_USERNAME=hourforge_migrator
MIGRATION_DB_PASSWORD=change_migration_me
POSTGRES_PASSWORD=change_admin_me

# Backups (service "backup"): the password that encrypts the restic repository. Keep it outside this server too: without it
# no backup can be read. BACKUP_REPOSITORY defaults to a local volume; for an off-site copy use e.g.
# s3:https://s3.eu-central-003.backblazeb2.com/<bucket>/hourforge with BACKUP_S3_ACCESS_KEY_ID and BACKUP_S3_SECRET_ACCESS_KEY.
BACKUP_PASSWORD=change_backup_me
# BACKUP_REPOSITORY=/repository
# BACKUP_INTERVAL_SECONDS=21600

# Images: built here by "docker compose build" unless set to published ones.
# BACKEND_IMAGE=hourforge-backend:local
# FRONTEND_IMAGE=hourforge-frontend:local

# Memory and CPU limits per container (defaults fit a 4 GB server). The backend keeps 75% of its memory for Java.
# BACKEND_MEMORY=1g
# BACKEND_CPUS=1.5
# POSTGRES_MEMORY=512m
# POSTGRES_CPUS=1
# FRONTEND_MEMORY=64m
# CADDY_MEMORY=128m
