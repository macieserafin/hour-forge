# A public name gets a Let's Encrypt certificate; "localhost" gets one from Caddy's local authority (for trying it out).
{$HOURFORGE_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# One identifier per request, set here so a client cannot choose it. The backend writes it into each of its log lines
	# (requestId) and returns it, so it also appears in this access log under the response headers.
	request_header X-Request-Id {http.request.uuid}

	# Pictures (profile photo, team logo) are up to 2 MB; every other request body is far below 1 MB
	# (the backend itself refuses more than 256 KB outside file uploads).
	@pictures path /api/account/avatar /api/teams/*/logo
	handle @pictures {
		request_body {
			max_size 3MB
		}
		reverse_proxy backend:8080
	}

	handle /api/* {
		request_body {
			max_size 1MB
		}
		reverse_proxy backend:8080
	}

	# For search engines: everything outside the API may be crawled, and the public pages are listed for this address.
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond <<TXT
			User-agent: *
			Disallow: /api/
			Sitemap: https://{$HOURFORGE_DOMAIN}/sitemap.xml
			TXT 200
	}

	handle /sitemap.xml {
		header Content-Type "application/xml; charset=utf-8"
		respond <<XML
			<?xml version="1.0" encoding="UTF-8"?>
			<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
			  <url><loc>https://{$HOURFORGE_DOMAIN}/login</loc></url>
			  <url><loc>https://{$HOURFORGE_DOMAIN}/register</loc></url>
			  <url><loc>https://{$HOURFORGE_DOMAIN}/privacy</loc></url>
			  <url><loc>https://{$HOURFORGE_DOMAIN}/terms</loc></url>
			  <url><loc>https://{$HOURFORGE_DOMAIN}/subprocessors</loc></url>
			</urlset>
			XML 200
	}

	handle {
		request_body {
			max_size 1MB
		}
		reverse_proxy frontend:8080
	}

	# Access log without secrets: links carry one-time tokens in the path (invitations, password reset, e-mail
	# confirmations, unsubscribe) and sign-in returns carry codes in the query, so both are masked. Cookie and
	# Authorization headers are already left out by Caddy.
	log {
		output stdout
		format filter {
			wrap json
			request>uri regexp "(/(?:invite|api/invites|reset-password|verify-email|confirm-email-change|confirm-account-deletion|unsubscribe)/|[?&][^=&]*=)[^/?&]+" "${1}REDACTED"
		}
	}
}

# www.<domain> leads to the application address.
www.{$HOURFORGE_DOMAIN} {
	redir https://{$HOURFORGE_DOMAIN}{uri} permanent
}
