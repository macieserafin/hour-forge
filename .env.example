# Copy to .env. Shared by Docker Compose and the backend.
COMPOSE_FILE=backend/compose.yaml
# Public frontend address used to generate team invitation links.
FRONTEND_URL=http://localhost:5173
# Use plain KEY=value entries without quotes, spaces, $ or backslash in values.
# For passwords, use long random letters/digits with e.g. - _ . !
DB_HOST=localhost
DB_PORT=55432
DB_NAME=hourforge
DB_USERNAME=hourforge
DB_PASSWORD=change_me
# Database administrator password; the backend uses DB_USERNAME/DB_PASSWORD.
POSTGRES_PASSWORD=change_admin_me

# Seed one local test account. Existing credentials are never overwritten.
SEED_USERS=true
SEED_USER_EMAIL=test@hourforge.local
SEED_USER_DISPLAY_NAME=TestUser
SEED_USER_PASSWORD=change_me_test_password
# Set true when the application is served over HTTPS.
SESSION_COOKIE_SECURE=false
