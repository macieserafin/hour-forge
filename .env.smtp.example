# Copy to .env.smtp (next to .env, kept out of Git) to test real e-mail on your computer through your own mail account
# instead of Mailpit. Used by the API with SPRING_PROFILES_ACTIVE=smtp and by deploy/compose.try-smtp.yaml.
# Steps: docs/development.md, "Real e-mail instead of Mailpit". Plain KEY=value, no quotes.

# OVH Zimbra mailbox of hourforge.pl (change for your own account). Port 587 with STARTTLS; the connection is always encrypted and the certificate checked.
SPRING_MAIL_HOST=smtp.mail.ovh.net
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=no-reply@hourforge.pl
# The mailbox password. Type it here only, never in a chat, an issue or a commit. The API reads this file like a
# .properties file (a backslash must be written as \\), Compose as an env file (a dollar sign must be written as $$);
# a password with neither character works in both.
SPRING_MAIL_PASSWORD=
MAIL_STARTTLS=true
MAIL_FROM=HourForge <no-reply@hourforge.pl>

# Required: the only address(es) that receive mail, comma-separated. Everything else (older test registrations, other
# people) never reaches the server: it stays in the local outbox, goes to Mailpit if you switch back within about two
# hours, and is marked failed after that.
MAIL_ALLOWED_RECIPIENTS=
